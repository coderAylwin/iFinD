# iFinD 数据下载环境变量配置
# 复制此文件为 .env，填入真实配置后使用
# 注意：.env 包含账号密码，务必加入 .gitignore，不要提交到仓库

# ===== iFinD 账号 =====
IFIND_USER=
IFIND_PASS=

# ===== 数据配置 =====
# 下载数据根目录（原始数据，不提交 git）
# 结构: {DATA_ROOT}/{market}/{year}/{code}.csv
DATA_ROOT=raw

# 每周预算限额（格子数，同花顺限制 1.5 亿）
WEEKLY_BUDGET=150000000

# 复权方式: no | forward1 | backward1 | forward3 | backward3
# no=不复权, forward1=前复权(分红方案), backward1=后复权(分红方案)
CPS=no

# 非交易时段填充: Original | Previous | Blank
FILL=Original

# ===== 推送 =====
# 每日用量推送时间（24小时制）
PUSH_TIME=18:00

# 用量告警阈值（百分比，超过则推送告警）
ALERT_THRESHOLD=80
